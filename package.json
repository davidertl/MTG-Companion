{
  "name": "mancutg-companion",
  "private": true,
  "type": "module",
  "scripts": {
    "api:start": "node --experimental-strip-types services/api/src/main.ts",
    "api:smoke": "node --experimental-strip-types services/api/src/smoke.ts",
    "arenac:build": "cargo build -p mancutg-arenac --bin mancutg-arenac-cli",
    "arenac:smoke": "bash scripts/arenac_smoke.sh",
    "arenac:dev": "cd apps/desktop && npm install && tauri dev -- -- --features gui",
    "arenac:bundle": "cd apps/desktop && npm install && tauri build -- --features gui",
    "paperc:dev": "cd apps/paperc && npm install && vite",
    "paperc:build": "cd apps/paperc && npm install && vite build",
    "desktop:help": "cargo run -p mancutg-arenac --bin mancutg-arenac-cli -- --help",
    "typecheck": "tsc --noEmit",
    "test:ts": "vitest run",
    "test:rust": "cargo test --workspace",
    "test:python": "python3 -m unittest discover -s services/archidekt-connector/tests -p \"test_*.py\"",
    "test": "npm run typecheck && npm run test:ts && npm run test:rust && npm run test:python",
    "verify:all": "bash scripts/verify_all.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
