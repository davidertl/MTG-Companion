{
  "name": "mancutg-companion",
  "private": true,
  "type": "module",
  "scripts": {
    "api:start": "node --experimental-strip-types services/api/src/main.ts",
    "api:smoke": "node --experimental-strip-types services/api/src/smoke.ts",
    "arenac:build": "cargo build -p mancutg-arenac",
    "arenac:serve": "cargo run -p mancutg-arenac -- serve",
    "arenac:smoke": "bash scripts/arenac_smoke.sh",
    "overwolf:build": "npm install --prefix apps/overwolf && npm run build --prefix apps/overwolf",
    "overwolf:smoke": "node scripts/overwolf_smoke.mjs",
    "desktop:help": "cargo run -p mancutg-arenac -- --help",
    "typecheck": "tsc --noEmit",
    "test:ts": "vitest run",
    "test:rust": "cargo test --workspace",
    "test:python": "python3 -m unittest discover -s services/archidekt-connector/tests -p \"test_*.py\"",
    "test": "npm run typecheck && npm run test:ts && npm run test:rust && npm run test:python"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
