{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "MancuTG-ArenaC",
    "author": "MancuTG",
    "version": "0.1.0",
    "minimum-overwolf-version": "0.169.0",
    "description": "Offline-first MTG Arena log companion (windowed MVP).",
    "dock_button_title": "ArenaC",
    "icon": "assets/IconMouseOver.png",
    "icon_gray": "assets/IconMouseNormal.png",
    "launcher_icon": "assets/launcher_icon.ico",
    "window_icon": "assets/window_icon.png",
    "splash_image": "assets/splash.png"
  },
  "permissions": ["GameInfo", "FileSystem"],
  "data": {
    "game_targeting": {
      "type": "dedicated",
      "game_ids": [21308]
    },
    "game_events": [21308],
    "launch_events": [
      {
        "event": "GameLaunch",
        "tracked": false,
        "event_data": {
          "game_ids": [21308]
        }
      }
    ],
    "start_window": "main",
    "windows": {
      "setup": {
        "file": "setup.html",
        "transparent": false,
        "resizable": true,
        "size": { "width": 520, "height": 420 },
        "min_size": { "width": 400, "height": 320 }
      },
      "main": {
        "file": "main.html",
        "transparent": false,
        "resizable": true,
        "size": { "width": 1100, "height": 720 },
        "min_size": { "width": 800, "height": 560 }
      },
      "imports": {
        "file": "imports.html",
        "transparent": false,
        "resizable": true,
        "size": { "width": 900, "height": 680 },
        "min_size": { "width": 720, "height": 520 }
      },
      "collection": {
