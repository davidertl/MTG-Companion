{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "services/**/*.ts",
    "services/**/*.py"
  ],
  "exclude": [
    "node_modules",
    "target",
    "apps/overwolf/node_modules",
    "apps/overwolf/dist",
    "apps/overwolf/**/*.ts",
    "apps/overwolf/**/*.tsx",
    "apps/paperc-desktop/**/*",
    "apps/paperc-desktop/node_modules",
    "apps/paperc-desktop/dist",
    "services/web/**/*",
    "services/web/node_modules",
    "services/web/dist"
  ]
}
